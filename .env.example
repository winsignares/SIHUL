# cp .env.example .env   (no subir .env a git; valores reales de produccion)

# Django / backend
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=sihul.unilibre.edu.co
FRONTEND_URL=https://sihul.unilibre.edu.co
DJANGO_SECRET_KEY=replace-with-generated-secret-key

# Microsoft / Azure Entra ID OAuth (Azure Portal > App registrations)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Archivos / NAS Universidad Libre
FINANCIERO_DOCUMENT_ROOT=/app/media
FINANCIERO_DOCUMENT_NETWORK_ROOT=
FINANCIERO_DOCUMENT_NETWORK_USER=
FINANCIERO_DOCUMENT_NETWORK_PASSWORD=

# Red Docker
DOCKER_NETWORK_SUBNET=10.201.2.0/24
DOCKER_NETWORK_GATEWAY=10.201.2.1

# Oracle (ETL academico, ver documentacion/documentacion_oracle/INTEGRACION_ETL_ORACLE.md)
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_SERVICE=
ORACLE_SECCIONAL_MATCH_MODE=smart
ETL_PERIODO=

# Chatbot (FastAPI + RAG)
OPENAI_API_KEY=
CHUNK_SIZE=900
CHUNK_OVERLAP=150
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Frontend (Vite, se lee desde la raiz)
VITE_API_URL=https://sihul.unilibre.edu.co
VITE_CHATBOT_URL=https://sihul.unilibre.edu.co
VITE_RECAPTCHA_SITE_KEY=
