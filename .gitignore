.devcontainer/

# Environment variables (NUNCA subir archivos .env con credenciales)
.env
.env.test
.env.local
.env.*.local
backend/.env
backend/.env.local
frontend/.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
*.egg-info/
dist/
build/

# Temporary files
temp_*.py
*_parsed.txt

# Django media uploads
backend/media/
backend/financiero/media/

# collectstatic output (se regenera en cada deploy)
backend/staticfiles/

# Variables de despliegue con secretos (las plantillas *.example sí se versionan)
!despliegue/env/
despliegue/env/*.env
!despliegue/env/*.env.example

# Estado local del despliegue (versión actual y anterior por entorno)
despliegue/.estado/
