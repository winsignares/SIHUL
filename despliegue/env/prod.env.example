# ============================================================================
# SIHUL — variables de PRODUCCIÓN. Copiar a despliegue/env/prod.env (NO se versiona).
#   cp despliegue/env/prod.env.example despliegue/env/prod.env && chmod 600 despliegue/env/prod.env
# Los nombres coinciden con el .env y el compose actuales del servidor: se copian sus valores.
# ============================================================================

COMPOSE_PROJECT_NAME=sihul
# Producción reutiliza los volúmenes existentes (sihul_postgres_data, sihul_media, sihul_redis_data).
# Con true, si alguno no existe Docker FALLA en vez de crear uno vacío.
VOLUMES_EXTERNAL=true
REGISTRY=ghcr.io/winsignares
TAG=latest                      # el script de despliegue la fija a la versión elegida

# --- Red de Docker: SUBRED FIJA (obligatoria). Son las MISMAS que usa hoy el servidor. ---
# Nunca dejar que Docker elija: podría chocar con la red de la universidad y cortar el acceso (SSH incluido).
DOCKER_NETWORK_SUBNET=10.201.2.0/24
DOCKER_NETWORK_GATEWAY=10.201.2.1

# --- Puertos publicados SOLO en 127.0.0.1 (el nginx del servidor es la entrada) ---
FRONTEND_PORT=8080
BACKEND_PORT=8000
CHATBOT_PORT=8001

# --- Base de datos: LOS MISMOS valores que usa hoy el servidor ---
DB_NAME=mypostgresdb
DB_USER=postgres
DB_PASSWORD=

# --- Django ---
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
# Incluye "backend" y 127.0.0.1: los usan los healthchecks internos.
# Copiar el valor ACTUAL del .env del servidor y AGREGAR backend,127.0.0.1 (los usa el healthcheck).
DJANGO_ALLOWED_HOSTS=sihul.unilibre.edu.co,backend,127.0.0.1,localhost
FRONTEND_URL=https://sihul.unilibre.edu.co
# CORS y CSRF: hoy NO están definidos en el servidor, así que rigen los valores por defecto del código.
# Se dejan VACÍOS para que producción se comporte exactamente igual que ahora.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
SESSION_COOKIE_NAME=sessionid
CSRF_COOKIE_NAME=csrftoken
# Módulo WSGI: cambiar a config.wsgi:application tras reorganizar el backend.
DJANGO_WSGI=mysite.wsgi:application

# --- Microsoft Entra ID / reCAPTCHA ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- NAS del módulo financiero ---
FINANCIERO_DOCUMENT_NETWORK_ROOT=
FINANCIERO_DOCUMENT_NETWORK_USER=
FINANCIERO_DOCUMENT_NETWORK_PASSWORD=

# --- Chatbot ---
OPENAI_API_KEY=
CHUNK_SIZE=900
CHUNK_OVERLAP=150
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# --- Frontend (build). Vacío = URLs relativas (/api) ---
VITE_API_URL=
VITE_CHATBOT_URL=

# --- Recursos: perfil para la VM ACTUAL (5,8 GB). Con 16 GB ver el bloque comentado ---
DB_MEM_LIMIT=768m
DB_CPUS=2
PG_SHARED_BUFFERS=192MB
PG_EFFECTIVE_CACHE_SIZE=512MB
PG_WORK_MEM=8MB
PG_MAX_CONNECTIONS=100
PG_SLOW_QUERY_MS=500
REDIS_MAXMEMORY=96mb
REDIS_MEM_LIMIT=160m
BACKEND_MEM_LIMIT=1792m
BACKEND_CPUS=2
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_MAX_REQUESTS=800
CHATBOT_MEM_LIMIT=512m
CHATBOT_CPUS=1
UVICORN_WORKERS=1
FRONTEND_MEM_LIMIT=64m

# --- Perfil para 16 GB de RAM (cuando TI amplíe la VM) ---
# DB_MEM_LIMIT=1536m
# PG_SHARED_BUFFERS=512MB
# PG_EFFECTIVE_CACHE_SIZE=1536MB
# BACKEND_MEM_LIMIT=2560m
# GUNICORN_WORKERS=3
# CHATBOT_MEM_LIMIT=1g
# UVICORN_WORKERS=2
# REDIS_MAXMEMORY=128mb
# REDIS_MEM_LIMIT=192m
