# ============================================================================
# SIHUL — variables del entorno de PRUEBAS. Copiar a despliegue/env/test.env (NO se versiona).
# Mismo compose que producción: otro proyecto, otros puertos, otras cookies y otra base de datos.
# Credenciales y claves PROPIAS de pruebas: nunca las de producción.
# Con 5,8 GB de RAM, pruebas se levanta SOLO cuando se usa (deploy.sh test ... y luego stop).
# ============================================================================

COMPOSE_PROJECT_NAME=sihul-test
VOLUMES_EXTERNAL=false
REGISTRY=ghcr.io/winsignares
TAG=latest

# Puertos en 127.0.0.1; el nginx del servidor los publica en http://IP:5273
FRONTEND_PORT=8180
BACKEND_PORT=8100
CHATBOT_PORT=8101

DB_NAME=sihul_test_db
DB_USER=sihul_test_user
DB_PASSWORD=
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=10.4.100.146,localhost,127.0.0.1,backend
FRONTEND_URL=http://10.4.100.146:5273
CORS_ALLOWED_ORIGINS=http://10.4.100.146:5273
CSRF_TRUSTED_ORIGINS=http://10.4.100.146:5273
# Pruebas va por http: las cookies "secure" no se enviarían y el login fallaría.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_NAME=sihul_test_sessionid
CSRF_COOKIE_NAME=sihul_test_csrftoken
DJANGO_WSGI=mysite.wsgi:application

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Pruebas no debe apuntar al NAS de producción.
FINANCIERO_DOCUMENT_NETWORK_ROOT=

OPENAI_API_KEY=
VITE_API_URL=
VITE_CHATBOT_URL=

# Límites bajos: pruebas no debe competir con producción por memoria.
DB_MEM_LIMIT=384m
DB_CPUS=1
PG_SHARED_BUFFERS=96MB
PG_EFFECTIVE_CACHE_SIZE=256MB
REDIS_MAXMEMORY=48mb
REDIS_MEM_LIMIT=96m
BACKEND_MEM_LIMIT=768m
BACKEND_CPUS=1
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
CHATBOT_MEM_LIMIT=384m
CHATBOT_CPUS=1
UVICORN_WORKERS=1
FRONTEND_MEM_LIMIT=48m
